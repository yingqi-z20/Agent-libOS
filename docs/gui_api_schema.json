{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-libos.local/schemas/gui-api/v2.json",
  "title": "Agent libOS local GUI API contract subset v2",
  "description": "Machine-readable same-build schema registry for the snapshot's top-level structure, process identity/state, content-free LLM call summaries, redacted Durable Task Run summaries/details, JSON error envelopes, and explicit-confirmation mutation payloads. The document root deliberately rejects instances: validators must select one of the named $defs entry points with a JSON Pointer fragment. Snapshot collection item semantics outside process, LLM call, and Task Run state remain renderer/server implementation details. This is not a complete public REST/OpenAPI specification.",
  "x-agent-libos-schema-version": 2,
  "x-agent-libos-contract-scope": {
    "snapshot": "GET /api/snapshot",
    "llm_call_summary": "GET /api/snapshot and llm_call.appended SSE payloads",
    "task_run_summary": "GET /api/snapshot and task_run.updated SSE payloads",
    "task_run_detail": "GET /api/task-runs/{run_id}",
    "error_envelope": "JSON errors from /api routes",
    "confirmed_operations": {
      "workflow.run": { "route": "POST /api/workflows/run", "request_def": "workflowRunPayload", "conditional": "Only workflow requests classified as high-risk require confirmed=true." },
      "process.signal": { "route": "POST /api/processes/{pid}/signal", "request_def": "processSignalPayload", "confirmed_values": ["cancel", "terminate"] },
      "process.exec": { "route": "POST /api/processes/{pid}/exec", "request_def": "processExecPayload" },
      "process.exit": { "route": "POST /api/processes/{pid}/exit", "request_def": "processExitPayload" },
      "checkpoint.restore": { "route": "POST /api/checkpoints/{checkpoint_id}/restore", "request_def": "checkpointRestorePayload" },
      "checkpoint.fork": { "route": "POST /api/checkpoints/{checkpoint_id}/fork", "request_def": "checkpointForkPayload" },
      "skill.register": { "route": "POST /api/skills/register", "request_def": "skillRegisterPayload" },
      "skill.activate": { "route": "POST /api/skills/{skill_id}/activate", "request_def": "skillActivatePayload" },
      "skill.unload": { "route": "POST /api/skills/{skill_id}/unload", "request_def": "skillProcessMutationPayload" },
      "capability.grant": { "route": "POST /api/capabilities/grant", "request_def": "capabilityGrantPayload" },
      "capability.delegate": { "route": "POST /api/capabilities/delegate", "request_def": "capabilityDelegatePayload" },
      "capability.revoke": { "route": "POST /api/capabilities/{capability_id}/revoke", "request_def": "capabilityRevokePayload" },
      "image.register": { "route": "POST /api/images/register", "request_def": "imageRegisterPayload" },
      "image.commit": { "route": "POST /api/images/commit", "request_def": "imageCommitPayload" },
      "jsonrpc.register": { "route": "POST /api/jsonrpc/register", "request_def": "registryManifestPayload" },
      "jsonrpc.call": { "route": "POST /api/jsonrpc/{endpoint_id}/call", "request_def": "jsonRpcCallPayload" },
      "mcp.register": { "route": "POST /api/mcp/register", "request_def": "registryManifestPayload" },
      "mcp.call": { "route": "POST /api/mcp/{server_id}/call", "request_def": "mcpCallPayload" },
      "task_run.cancel": { "route": "POST /api/task-runs/{run_id}/cancel", "request_def": "taskRunCancelPayload" },
      "task_run.recover": { "route": "POST /api/task-runs/{run_id}/recover", "request_def": "taskRunRecoverPayload" }
    }
  },
  "x-agent-libos-definition-usage": {
    "root_validation": "The registry root is not an instance schema and always rejects. Select a definition explicitly.",
    "local_ref_example": "./gui_api_schema.json#/$defs/processExecPayload",
    "canonical_ref_example": "https://agent-libos.local/schemas/gui-api/v2.json#/$defs/processExecPayload"
  },
  "not": {},
  "$defs": {
    "jsonObject": {
      "type": "object",
      "additionalProperties": true
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilityRights": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      ]
    },
    "confirmedMutation": {
      "type": "object",
      "required": ["confirmed"],
      "properties": {
        "confirmed": { "const": true }
      },
      "additionalProperties": true
    },
    "actorMutation": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "noActor": {
      "not": { "required": ["actor"] }
    },
    "schedulerStatus": {
      "type": "object",
      "required": ["auto_run", "running", "paused"],
      "properties": {
        "auto_run": { "type": "boolean" },
        "running": { "type": "boolean" },
        "paused": { "type": "boolean" },
        "task_id": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "last_result": { "type": "array" },
        "last_error": { "type": ["string", "null"] },
        "started_at": { "type": ["number", "null"] },
        "finished_at": { "type": ["number", "null"] },
        "default_max_quanta": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": true
    },
    "processWaitState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["schema_version", "kind", "child_pid"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "child" },
            "child_pid": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schema_version", "kind", "filters"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "message" },
            "filters": { "type": "object" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schema_version", "kind", "request_ids"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "human" },
            "request_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schema_version", "kind", "operation_id"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "tool" },
            "operation_id": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schema_version", "kind", "reason_oid"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "paused" },
            "reason_oid": {
              "oneOf": [
                { "$ref": "#/$defs/nonEmptyString" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schema_version", "kind", "reason_oid"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "host_resume" },
            "reason_oid": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Diagnostic stale-execution takeover projection; not independent TaskRun resume authority.",
          "required": [
            "schema_version",
            "kind",
            "pid",
            "recovered_by_owner_sha256",
            "prior_owner_sha256",
            "prior_lease_sha256",
            "prior_execution_generation",
            "recovered_execution_generation",
            "recovered_state_generation"
          ],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "stale_execution" },
            "pid": { "$ref": "#/$defs/nonEmptyString" },
            "recovered_by_owner_sha256": { "$ref": "#/$defs/sha256" },
            "prior_owner_sha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "prior_lease_sha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "prior_execution_generation": { "type": "integer", "minimum": 0 },
            "recovered_execution_generation": { "type": "integer", "minimum": 1 },
            "recovered_state_generation": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "processSummary": {
      "type": "object",
      "required": ["pid", "status"],
      "properties": {
        "pid": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "wait_state": {
          "oneOf": [
            { "$ref": "#/$defs/processWaitState" },
            { "type": "null" }
          ]
        },
        "messages": { "type": "array" },
        "terminal": { "type": "boolean" },
        "unread_message_count": { "type": "integer", "minimum": 0 },
        "interrupt_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "llmCallSummary": {
      "type": "object",
      "required": [
        "schema_version",
        "call_id",
        "pid",
        "image_id",
        "purpose",
        "status",
        "api",
        "model",
        "usage",
        "error",
        "created_at",
        "completed_at",
        "request_id",
        "response_id",
        "attempt_count",
        "coverage",
        "selected_attempt",
        "reasoning_availability",
        "payload_retention_tier"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "call_id": { "$ref": "#/$defs/nonEmptyString" },
        "pid": { "type": ["string", "null"] },
        "image_id": { "type": ["string", "null"] },
        "purpose": { "type": "string" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "api": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "usage": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "prompt_tokens",
              "completion_tokens",
              "total_tokens",
              "input_tokens",
              "output_tokens",
              "cache_read_tokens",
              "cache_write_tokens"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "error": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/nonEmptyString" },
        "completed_at": { "type": ["string", "null"] },
        "request_id": { "type": ["string", "null"] },
        "response_id": { "type": ["string", "null"] },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "coverage": {
          "enum": ["complete", "custom_client_incomplete", "legacy_final_only"]
        },
        "selected_attempt": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 256 },
            { "type": "null" }
          ]
        },
        "reasoning_availability": {
          "enum": ["returned", "not_returned", "not_persisted", "purged", "limited"]
        },
        "payload_retention_tier": {
          "enum": ["full", "summary", "hash_only"]
        }
      },
      "additionalProperties": false
    },
    "taskRunBlocker": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "unknown_effect",
            "effect_unknown",
            "payload_missing",
            "payload_corrupt",
            "binding_drift",
            "pending_action_unreplayable",
            "active_object_task",
            "requirements_unsatisfied",
            "cleanup_failed",
            "authority_revoked",
            "deadline_reached",
            "effect_unsettled",
            "reservation_unsettled",
            "publication_unsettled",
            "manual_recovery_required"
          ]
        },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "process_id": { "type": "string" },
        "effect_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "taskRunSummary": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "revision",
        "status",
        "display_title",
        "root_pid",
        "active_pid",
        "allowed_actions",
        "blockers",
        "retention",
        "payloads_purged"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": [
            "queued",
            "running",
            "waiting_human",
            "waiting_process",
            "waiting_message",
            "waiting_tool",
            "paused",
            "cancelling",
            "finalizing",
            "needs_attention",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "display_title": { "$ref": "#/$defs/nonEmptyString" },
        "root_pid": { "type": ["string", "null"] },
        "active_pid": { "type": ["string", "null"] },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["run", "wait", "pause", "resume", "cancel", "follow_up", "recover", "rerun"] }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/taskRunBlocker" } },
        "retention": { "enum": ["purge_on_terminal", "permanent"] },
        "payloads_purged": { "type": "boolean" },
        "requirement_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "step_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "step_count": { "type": "integer", "minimum": 0 },
        "completed_step_count": { "type": "integer", "minimum": 0 },
        "result_ref": { "type": ["string", "null"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "taskRunRequirement": {
      "type": "object",
      "required": [
        "schema_version",
        "requirement_id",
        "run_id",
        "ordinal",
        "kind",
        "status",
        "requirement_sha256",
        "label",
        "created_by",
        "created_at",
        "updated_at",
        "started_at",
        "completed_at",
        "waived_by",
        "content_available",
        "content_retention",
        "content_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "requirement_id": { "$ref": "#/$defs/nonEmptyString" },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["initial", "follow_up"] },
        "status": { "enum": ["pending", "in_progress", "satisfied", "blocked", "waived"] },
        "requirement_sha256": { "$ref": "#/$defs/sha256" },
        "label": { "type": "string" },
        "created_by": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "waived_by": { "type": ["string", "null"] },
        "content_available": { "type": "boolean" },
        "content_retention": { "enum": ["plaintext", "hash_only"] },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "content_text": { "type": "string" },
        "content_truncated": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "content_retention": { "const": "hash_only" } }, "required": ["content_retention"] },
          "then": { "properties": { "content_available": { "const": false } }, "not": { "required": ["content_text"] } }
        }
      ],
      "additionalProperties": false
    },
    "taskRunDetailResponse": {
      "type": "object",
      "required": ["summary", "requirements", "recovery_options"],
      "properties": {
        "summary": { "$ref": "#/$defs/taskRunSummary" },
        "requirements": {
          "type": "object",
          "required": ["items", "next_cursor", "has_more"],
          "properties": {
            "items": { "type": "array", "items": { "$ref": "#/$defs/taskRunRequirement" } },
            "next_cursor": { "type": ["string", "null"] },
            "has_more": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "recovery_options": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } }
      },
      "additionalProperties": false
    },
    "snapshotResponse": {
      "type": "object",
      "required": [
        "schema_version",
        "db",
        "scheduler",
        "processes",
        "human_requests",
        "events",
        "audit",
        "llm_calls",
        "object_tasks",
        "task_runs",
        "tools",
        "images",
        "skills",
        "jsonrpc_endpoints",
        "mcp_servers",
        "modules",
        "llm_profiles"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "db": { "type": "string" },
        "scheduler": { "$ref": "#/$defs/schedulerStatus" },
        "processes": { "type": "array", "items": { "$ref": "#/$defs/processSummary" } },
        "human_requests": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "audit": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "llm_calls": { "type": "array", "items": { "$ref": "#/$defs/llmCallSummary" } },
        "object_tasks": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "task_runs": { "type": "array", "items": { "$ref": "#/$defs/taskRunSummary" } },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "images": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "jsonrpc_endpoints": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "mcp_servers": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "llm_profiles": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
        "_truncated": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "errorEnvelope": {
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "type": { "type": "string" },
            "code": { "type": "string" },
            "message": { "type": "string" },
            "confirmation_required": { "type": "boolean" },
            "action": { "type": "string" },
            "preview": { "type": "object", "additionalProperties": true },
            "retryable": { "type": "boolean" },
            "status": { "type": "string" },
            "command_admitted": { "type": "boolean" },
            "current_summary": { "$ref": "#/$defs/taskRunSummary" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "workflowRunPayload": {
      "allOf": [
        { "$ref": "#/$defs/noActor" },
        {
          "type": "object",
          "required": ["tool"],
          "properties": {
            "tool": { "$ref": "#/$defs/nonEmptyString" },
            "args": { "$ref": "#/$defs/jsonObject" },
            "image": { "$ref": "#/$defs/nonEmptyString" },
            "working_directory": { "$ref": "#/$defs/nonEmptyString" },
            "authority_manifest": { "$ref": "#/$defs/jsonObject" },
            "confirmed": { "type": "boolean" }
          }
        }
      ]
    },
    "processSignalPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        {
          "required": ["signal"],
          "properties": {
            "signal": { "enum": ["cancel", "terminate"] },
            "payload": { "$ref": "#/$defs/jsonObject" }
          }
        }
      ]
    },
    "processExecPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        {
          "required": ["image"],
          "properties": {
            "image": { "$ref": "#/$defs/nonEmptyString" },
            "goal": {
              "oneOf": [
                { "type": "string" },
                { "$ref": "#/$defs/jsonObject" },
                { "type": "null" }
              ]
            },
            "llm_profile": { "type": ["string", "null"] },
            "args": { "$ref": "#/$defs/jsonObject" },
            "preserve_memory": { "type": "boolean" },
            "preserve_capabilities": { "type": "boolean" },
            "auto_run": { "type": "boolean" },
            "max_quanta": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "processExitPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        {
          "properties": {
            "failed": { "type": "boolean" },
            "message": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "checkpointRestorePayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" }
      ]
    },
    "checkpointForkPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        { "properties": { "parent_pid": { "type": ["string", "null"] } } }
      ]
    },
    "skillRegisterPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["actor", "path"],
          "properties": {
            "actor": { "$ref": "#/$defs/nonEmptyString" },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
            },
            "replace": { "type": "boolean" }
          }
        }
      ]
    },
    "skillProcessMutationPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["pid"],
          "properties": { "pid": { "$ref": "#/$defs/nonEmptyString" } }
        }
      ]
    },
    "skillActivatePayload": {
      "allOf": [
        { "$ref": "#/$defs/skillProcessMutationPayload" },
        {
          "required": ["expected_package_sha256"],
          "properties": {
            "expected_package_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "capabilityGrantPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["subject", "resource"],
          "properties": {
            "subject": { "$ref": "#/$defs/nonEmptyString" },
            "resource": { "$ref": "#/$defs/nonEmptyString" },
            "rights": { "$ref": "#/$defs/capabilityRights" }
          }
        }
      ]
    },
    "capabilityDelegatePayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["parent", "child", "resource"],
          "properties": {
            "parent": { "$ref": "#/$defs/nonEmptyString" },
            "child": { "$ref": "#/$defs/nonEmptyString" },
            "resource": { "$ref": "#/$defs/nonEmptyString" },
            "rights": { "$ref": "#/$defs/capabilityRights" }
          }
        }
      ]
    },
    "capabilityRevokePayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        { "properties": { "reason": { "type": ["string", "null"] } } }
      ]
    },
    "imageRegisterPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["files"],
          "not": { "required": ["path"] },
          "properties": {
            "files": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
              "additionalProperties": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["base64"],
                    "properties": { "base64": { "type": "string" } },
                    "additionalProperties": true
                  }
                ]
              }
            },
            "source": { "type": ["string", "null"] },
            "replace": { "type": "boolean" }
          }
        }
      ]
    },
    "imageCommitPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["checkpoint_id", "image_id", "name"],
          "properties": {
            "checkpoint_id": { "$ref": "#/$defs/nonEmptyString" },
            "image_id": { "$ref": "#/$defs/nonEmptyString" },
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "replace": { "type": "boolean" },
            "metadata": { "$ref": "#/$defs/jsonObject" }
          }
        }
      ]
    },
    "registryManifestPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/actorMutation" },
        {
          "required": ["manifest_text"],
          "not": { "required": ["path"] },
          "properties": {
            "manifest_text": { "$ref": "#/$defs/nonEmptyString" },
            "replace": { "type": "boolean" },
            "source": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "jsonRpcCallPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        {
          "required": ["pid", "method_id"],
          "properties": {
            "pid": { "$ref": "#/$defs/nonEmptyString" },
            "method_id": { "$ref": "#/$defs/nonEmptyString" },
            "params": {}
          }
        }
      ]
    },
    "mcpCallPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        {
          "required": ["pid", "tool_id"],
          "properties": {
            "pid": { "$ref": "#/$defs/nonEmptyString" },
            "tool_id": { "$ref": "#/$defs/nonEmptyString" },
            "arguments": {
              "oneOf": [
                { "$ref": "#/$defs/jsonObject" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "taskRunCommandMutation": {
      "type": "object",
      "required": ["expected_revision", "command_id"],
      "properties": {
        "expected_revision": { "type": "integer", "minimum": 0 },
        "command_id": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "taskRunCancelPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        { "$ref": "#/$defs/taskRunCommandMutation" },
        { "properties": { "reason": { "type": "string" } } }
      ]
    },
    "taskRunRecoverPayload": {
      "allOf": [
        { "$ref": "#/$defs/confirmedMutation" },
        { "$ref": "#/$defs/noActor" },
        { "$ref": "#/$defs/taskRunCommandMutation" },
        {
          "required": ["option_id"],
          "properties": {
            "option_id": { "$ref": "#/$defs/nonEmptyString" },
            "receipt": {
              "oneOf": [
                { "$ref": "#/$defs/jsonObject" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    }
  }
}
