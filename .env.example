# Copy this file to .env and fill in the two required values below.
# Keep real credentials in .env (already ignored by Git), not in this template.
# Load explicitly: uv run --env-file .env <command>

# Required for the real-LLM evaluation entrypoints.
OPENAI_API_KEY=
OPENAI_LANGUAGE_MODEL=

# API root, including the provider's version prefix; not a completions URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# For a custom OpenAI-compatible endpoint, change OPENAI_BASE_URL above and
# uncomment this Host opt-in. Leave it disabled for the official endpoint.
# AGENT_LIBOS_ALLOW_CUSTOM_LLM_BASE_URL=1

# auto | responses | chat
# Use chat if your provider only supports Chat Completions.
OPENAI_API_MODE=auto

# Bounded transport settings; timeout is in seconds per attempt.
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=2
OPENAI_STORE=false

# Optional: enable only when supported by the selected provider/model.
# OPENAI_REASONING_EFFORT=medium
# OPENAI_VERBOSITY=low

# Paid long-horizon evaluation (after filling in .env):
# uv run --env-file .env python experiments/run_long_horizon_evaluation.py --confirm-real-llm --require-all-successful --output .benchmark_runs/long-horizon/report.json
